{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "color": {
      "1": "blue"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "blue",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "key": "​ ​ ",
      "keyColor": "blue",
      "format": "\u001b[1;34m{user-name}@{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[37m┌───────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "​ ​ ",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "​ ​ ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "​ ​ ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "​ ​ ",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "​ ​ 󰔚",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "​ ​ ",
      "keyColor": "blue",
      "format": "{all}"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└───────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "  \u001b[31m\u001b[0m   \u001b[32m\u001b[0m   \u001b[33m\u001b[0m   \u001b[34m\u001b[0m   \u001b[35m\u001b[0m   \u001b[36m\u001b[0m   \u001b[37m\u001b[0m   \u001b[30m\u001b[0m"
    }
  ]
}
